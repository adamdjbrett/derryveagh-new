---
layout: null
permalink: /sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {%- for collection in site.collections -%}
    {%- if collection.output -%}
      {%- for doc in collection.docs -%}
        {%- unless doc.sitemap == false -%}
          {% include sitemap-url.xml path=doc.url modified=doc.last_modified_at date=doc.date %}
        {%- endunless -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endfor -%}
  {%- for doc in site.html_pages -%}
    {%- unless doc.sitemap == false or doc.url == '/404.html' -%}
      {% include sitemap-url.xml path=doc.url modified=doc.last_modified_at %}
    {%- endunless -%}
  {%- endfor -%}
  {%- assign extensions = '.htm .html .xhtml .pdf' | split: ' ' -%}
  {%- for file in site.static_files -%}
    {%- if extensions contains file.extname and file.sitemap != false and file.name != '404.html' -%}
      {% include sitemap-url.xml path=file.path modified=file.modified_time %}
    {%- endif -%}
  {%- endfor %}
</urlset>
