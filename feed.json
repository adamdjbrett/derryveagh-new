---
layout: null
permalink: /feed.json
sitemap: false
---
{
  "version": "https://jsonfeed.org/version/1.1",
  "title": {{ site.title | jsonify }},
  "home_page_url": {{ '/' | absolute_url | jsonify }},
  "feed_url": {{ page.url | absolute_url | jsonify }},
  "items": [
    {%- assign posts = site.posts | sort: "date" | reverse %}
    {%- assign limit = site.feed.posts_limit | default: 10 %}
    {%- for post in posts limit: limit %}
    {% assign author = post | scholarly_author: site -%}
    {% assign body = post.content | strip_html | normalize_whitespace -%}
    {% assign summary = post.excerpt | strip_html | normalize_whitespace -%}
    {% assign image = post.header.image | default: post.preview | default: post.gallery.first.image_path -%}
    {
      "id": {{ post.url | absolute_url | jsonify }},
      "url": {{ post.url | absolute_url | jsonify }},
      "title": {{ post.title | strip_html | jsonify }},
      "content_text": {{ body | default: summary | default: post.title | jsonify }},
      {% if image %}"image": {{ image | absolute_url | jsonify }},{% endif %}
      "date_published": {{ post.date | date_to_xmlschema | jsonify }}{% if author %},
      "authors": [{"name": {{ author.name | jsonify }}{% if author.url %}, "url": {{ author.url | jsonify }}{% endif %}}]{% endif %}
    }{% unless forloop.last %},{% endunless %}
    {%- endfor %}
  ]
}
