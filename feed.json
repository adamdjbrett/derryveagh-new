---
layout: null
permalink: /feed.json
sitemap: false
---
{%- assign hosted_root = '/' | absolute_url -%}
{%- assign home = site.url | append: '/' -%}
{
  "version": "https://jsonfeed.org/version/1.1",
  "title": {{ site.title | jsonify }},
  "home_page_url": {{ '/' | prepend: site.url | absolute_url | jsonify }},
  "feed_url": {{ page.url | prepend: site.url | absolute_url | jsonify }},
  "items": [
    {%- assign posts = site.posts | sort: "date" | reverse %}
    {%- assign limit = site.feed.posts_limit | default: 10 %}
    {%- for post in posts limit: limit %}
    {% capture author_name %}{% include entry-author.html entry=post field="name" %}{% endcapture %}
    {% capture author_url %}{% include entry-author.html entry=post field="url" %}{% endcapture %}
    {% assign body = post.content | strip_html | normalize_whitespace -%}
    {% assign summary = post.excerpt | strip_html | normalize_whitespace -%}
    {% assign image = post.header.image | default: post.preview | default: post.gallery.first.image_path -%}
    {
      "id": {{ post.url | prepend: site.url | absolute_url | jsonify }},
      "url": {{ post.url | prepend: site.url | absolute_url | jsonify }},
      "title": {{ post.title | strip_html | jsonify }},
      "content_text": {{ body | default: summary | default: post.title | jsonify }},
      {% if image %}"image": {{ image | absolute_url | replace_first: hosted_root, home | jsonify }},{% endif %}
      "date_published": {{ post.date | date_to_xmlschema | jsonify }}{% if author_name and author_name != empty %},
      "authors": [{"name": {{ author_name | jsonify }}{% if author_url and author_url != empty %}, "url": {{ author_url | jsonify }}{% endif %}}]{% endif %}
    }{% unless forloop.last %},{% endunless %}
    {%- endfor %}
  ]
}
